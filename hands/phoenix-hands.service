# phoenix-hands — H.L.K's hands on a headless Phoenix box (hands/hands.py).
# UnitedSys — United Systems | jwl247 | GPL-3.0
# Listens on 127.0.0.1 + this box's Phoenix Mesh (Nebula 10.42.x) address; only
# the Console's PC (PBMII, 10.42.0.1) may call, and only with this box's token.
# The update hop runs inside the Nebula mesh, which authenticates + encrypts it
# (validated once at the door; no extra signature layer).
# Installed ONCE by hands/install_remote.py; after that it imports new
# versions of itself from the clone pool through the hub (build once).
[Unit]
Description=Phoenix hands (Console actions on this machine)
After=network-online.target nebula.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/phoenix-hands/hands.py --mesh --allow-from 10.42.0.1 --update-from http://10.42.0.1:8470/pool/hands.py
# always: a self-update exits 0 on purpose so the new version starts
Restart=always
RestartSec=5
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
