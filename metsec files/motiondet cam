/**
 * FILE MOTION SENSOR MODULE
 * Isolated, lightweight module for detecting file changes
 * No heavy hashing - just motion detection and versioning
 * Designed to trigger external modules (permissions, hashing, cloud backup)
 */

class FileMotionSensor {
  constructor(config = {}) {
    this.config = {
      maxLocalSnapshots: config.maxLocalSnapshots || 100,
      snapshotDir: config.snapshotDir || './snapshots',
      triggerThreshold: config.triggerThreshold || 1, // Changes before triggering
      checkInterval: config.checkInterval || 5000, // ms
      ...config
    };
    
    this.watchedPaths = new Map();
    this.motionQueue = [];
    this.snapshotCount = 0;
    this.callbacks = {
      onMotion: null,
      onCapReached: null,
      onPermissionCheck: null
    };
  }

  // Register callback hooks for external modules
  on(event, callback) {
    this.callbacks[event] = callback;
  }

  // Add directory to watch
  watch(path, options = {}) {
    const watcher = {
      path: path,
      lastState: null,
      changeCount: 0,
      permissions: options.permissions || 'read-write',
      priority: options.priority || 'normal',
      enabled: true
    };
    
    this.watchedPaths.set(path, watcher);
    this.captureState(path); // Initial state
    return watcher;
  }

  // Lightweight state capture (just metadata, no file contents)
  async captureState(path) {
    // In real implementation, this would use fs.stat for metadata only
    const state = {
      timestamp: Date.now(),
      path: path,
      fileCount: Math.floor(Math.random() * 50), // Simulated
      lastModified: Date.now(),
      permissions: '755' // Simulated
    };
    
    const watcher = this.watchedPaths.get(path);
    if (watcher) {
      watcher.lastState = state;
    }
    
    return state;
  }

  // Detect motion (changes)
  async detectMotion(path) {
    const watcher = this.watchedPaths.get(path);
    if (!watcher || !watcher.enabled) return null;

    const currentState = await this.captureState(path);
    const previousState = watcher.lastState;

    if (!previousState) return null;

    // Compare states (lightweight comparison)
    const hasMotion = 
      currentState.fileCount !== previousState.fileCount ||
      currentState.lastModified !== previousState.lastModified ||
      currentState.permissions !== previousState.permissions;

    if (hasMotion) {
      watcher.changeCount++;
      
      const motion = {
        id: `motion_${Date.now()}`,
        path: path,
        timestamp: Date.now(),
        changeType: this.detectChangeType(currentState, previousState),
        priority: watcher.priority,
        previousState: previousState,
        currentState: currentState
      };

      this.motionQueue.push(motion);
      
      // Trigger permission check immediately
      if (this.callbacks.onPermissionCheck) {
        await this.callbacks.onPermissionCheck(motion);
      }

      // Trigger motion callback
      if (watcher.changeCount >= this.config.triggerThreshold) {
        if (this.callbacks.onMotion) {
          await this.callbacks.onMotion(motion);
        }
        watcher.changeCount = 0; // Reset
      }

      return motion;
    }

    return null;
  }

  detectChangeType(current, previous) {
    if (current.fileCount > previous.fileCount) return 'files_added';
    if (current.fileCount < previous.fileCount) return 'files_removed';
    if (current.permissions !== previous.permissions) return 'permissions_changed';
    return 'files_modified';
  }

  // Create lightweight snapshot (metadata only)
  async createSnapshot(path) {
    const state = await this.captureState(path);
    this.snapshotCount++;

    const snapshot = {
      id: `snapshot_${this.snapshotCount}`,
      ...state,
      type: 'lightweight',
      size: 1024 // Simulated KB
    };

    // Check if cap reached
    if (this.snapshotCount >= this.config.maxLocalSnapshots) {
      if (this.callbacks.onCapReached) {
        await this.callbacks.onCapReached({
          snapshotCount: this.snapshotCount,
          readyForShipping: this.getShippableSnapshots()
        });
      }
    }

    return snapshot;
  }

  // Get snapshots ready for cloud shipping
  getShippableSnapshots() {
    // In real implementation, this would zip and prepare for cloud transfer
    return {
      count: this.snapshotCount,
      estimatedSize: this.snapshotCount * 1024, // KB
      readyToShip: this.snapshotCount >= this.config.maxLocalSnapshots
    };
  }

  // Start monitoring all watched paths
  startMonitoring() {
    this.monitoringInterval = setInterval(async () => {
      for (const [path, watcher] of this.watchedPaths) {
        if (watcher.enabled) {
          await this.detectMotion(path);
        }
      }
    }, this.config.checkInterval);
  }

  stopMonitoring() {
    if (this.monitoringInterval) {
      clearInterval(this.monitoringInterval);
    }
  }

  // Get motion events for reporting
  getMotionLog() {
    return this.motionQueue;
  }

  // Clear shipped snapshots
  clearShippedSnapshots() {
    this.snapshotCount = 0;
    this.motionQueue = [];
  }
}


