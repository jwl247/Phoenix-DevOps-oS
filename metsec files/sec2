  _calculateAverageInterval(dataPoints) {
    if (dataPoints.length < 2) return 0;
    
    let totalInterval = 0;
    for (let i = 1; i < dataPoints.length; i++) {
      totalInterval += dataPoints[i].timestamp - dataPoints[i - 1].timestamp;
    }
    
    return totalInterval / (dataPoints.length - 1);
  }

  _detectBurst(dataPoints) {
    // Detect if attacker sent many requests in quick succession
    const burstThreshold = 1000; // 1 second
    let maxBurst = 0;
    let currentBurst = 1;

    for (let i = 1; i < dataPoints.length; i++) {
      const interval = dataPoints[i].timestamp - dataPoints[i - 1].timestamp;
      if (interval < burstThreshold) {
        currentBurst++;
        maxBurst = Math.max(maxBurst, currentBurst);
      } else {
        currentBurst = 1;
      }
    }

    return maxBurst >= 5 ? { detected: true, size: maxBurst } : { detected: false };
  }

  _getMostCommon(arr) {
    const counts = {};
    arr.forEach(item => counts[item] = (counts[item] || 0) + 1);
    return Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b, 'unknown');
  }

  _assessSophistication(session) {
    const score = session.suspicionLevel / 10;
    const uniqueTechniques = new Set(session.techniques).size;
    
    if (uniqueTechniques >= 5 || score >= 8) return 'advanced';
    if (uniqueTechniques >= 3 || score >= 5) return 'intermediate';
    return 'script_kiddie';
  }

  _inferTools(session) {
    const tools = new Set();
    
    session.dataPoints.forEach(dp => {
      if (dp.metadata.userAgent) {
        if (dp.metadata.userAgent.includes('sqlmap')) tools.add('sqlmap');
        if (dp.metadata.userAgent.includes('nikto')) tools.add('nikto');
        if (dp.metadata.userAgent.includes('nmap')) tools.add('nmap');
        if (dp.metadata.userAgent.includes('curl')) tools.add('curl');
        if (dp.metadata.userAgent.includes('python')) tools.add('custom_script');
      }
    });

    if (tools.size === 0) tools.add('manual_browser');
    
    return Array.from(tools);
  }

  _recommendResponse(session) {
    const sophistication = this._assessSophistication(session);
    
    if (sophistication === 'advanced') {
      return 'full_lockdown_and_aggressive_bounce';
    } else if (sophistication === 'intermediate') {
      return 'lockdown_and_moderate_bounce';
    } else {
      return 'lockdown_and_warn';
    }
  }

