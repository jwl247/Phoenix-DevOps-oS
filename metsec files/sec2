  _evaluateSnapCondition(session) {
    const thresholds = this.config.snapThreshold;

    // Count technique types
    const techniqueCount = {};
    session.techniques.forEach(t => {
      techniqueCount[t] = (techniqueCount[t] || 0) + 1;
    });

    // Check conditions
    if (techniqueCount['sql_injection'] >= thresholds.sqlInjectionAttempts) {
      return { snap: true, reason: 'SQL injection threshold exceeded' };
    }

    if (techniqueCount['command_injection'] >= thresholds.commandInjectionAttempts) {
      return { snap: true, reason: 'Command injection detected' };
    }

    if (session.suspicionLevel >= 50) {
      return { snap: true, reason: 'Suspicion level critical' };
    }

    if (session.dataPoints.length >= this.config.minDataPoints) {
      // Check if we've learned enough
      const uniqueTechniques = new Set(session.techniques).size;
      if (uniqueTechniques >= 3) {
        return { snap: true, reason: 'Sufficient intelligence gathered' };
      }
    }

    // Check time-based snap
    const elapsed = Date.now() - session.startTime;
    if (elapsed >= this.config.absorptionTime && session.dataPoints.length >= this.config.minDataPoints) {
      return { snap: true, reason: 'Absorption time complete' };
    }

    return { snap: false };
  }

  async snap(attackerId, reason) {
