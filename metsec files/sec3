const BufferSystem = require('./buffer-system');
const LockdownModule = require('./lockdown-module');

// Initialize modules
const buffer = new BufferSystem();
const lockdown = new LockdownModule();
const bouncer = new SignalMirrorBouncer({
  enableBounce: false, // SAFETY: Start disabled, enable manually
  amplificationFactor: 10,
  maxThreads: 1000,
  jmeterPath: '/opt/apache-jmeter/bin/jmeter'
});

// Integration hook
async function handleSecurityIncident(motion) {
  // 1. Buffer escalation
  const bufferResult = await buffer.processChange(motion);
  
  // 2. Capture and potentially bounce
  const bounceResult = await bouncer.handleBufferEscalation(
    bufferResult.buffer, 
    {
      ...motion,
      bufferLevel: bufferResult.buffer,
      sourceIP: '192.168.1.100', // Extract from motion
      requestCount: 500 // Extract from motion
    }
  );

  // 3. Execute lockdown if needed
  if (bufferResult.buffer === 'SOCK5') {
    await lockdown.execute(motion);
  }

  return {
    buffer: bufferResult,
    bounce: bounceResult,
    lockdown: bufferResult.buffer === 'SOCK5' ? 'executed' : 'not_needed'
  };
}

