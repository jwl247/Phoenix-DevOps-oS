{
  // packages-worker — Phoenix DevOps OS
  // UnitedSys — United Systems | jwl247
  // Deploy: wrangler deploy
  // Tail:   wrangler tail
  // Secret: do NOT run `wrangler secret put PHOENIX_AUTH` here by hand — it
  //         must match phoenix-clonepool-r2's secret AND the local registry
  //         value. Use ../rotate-phoenix-auth.sh, which sets and verifies
  //         all three together.

  "name": "packages-worker",
  "main": "index.js",
  "compatibility_date": "2025-01-01",

  // ── D1 Binding ─────────────────────────────────────────────────────────────
  // PHOENIX_DB → phoenix_dev_db (the backbone — all tables live here)
  "d1_databases": [
    {
      "binding":       "PHOENIX_DB",
      "database_name": "phoenix_dev_db",
      "database_id":   "27958687-4349-47ed-8b6a-dbc4ab29730f"
    }
  ]

  // ── Secrets ────────────────────────────────────────────────────────────────
  // PHOENIX_AUTH — rotate via ../rotate-phoenix-auth.sh, never by hand
  // Never put the token here — secrets only
}
