{
  // packages-worker — Phoenix DevOps OS
  // UnitedSys — United Systems | jwl247
  // Deploy: wrangler deploy
  // Tail:   wrangler tail
  // Secret: wrangler secret put PHOENIX_AUTH

  "name": "packages-worker",
  "main": "index.js",
  "compatibility_date": "2025-01-01",

  // ── D1 Binding ─────────────────────────────────────────────────────────────
  // PHOENIX_DB → phoenix_dev_db (the backbone — all tables live here)
  "d1_databases": [
    {
      "binding":       "PHOENIX_DB",
      "database_name": "phoenix_dev_db",
      "database_id":   "27958687-4349-47ed-8b6a-dbc4ab29730f"
    }
  ],

  // ── R2 Binding ─────────────────────────────────────────────────────────────
  // CLONEPOOL_BUCKET → phoenix-clonepool (actual file bytes; D1 clonepool table
  // holds metadata/hashes only — this is what PUT/GET/DELETE /clonepool/:hex
  // and the /versions/:hash sub-routes read and write)
  "r2_buckets": [
    {
      "binding":     "CLONEPOOL_BUCKET",
      "bucket_name": "phoenix-clonepool"
    }
  ]

  // ── Secrets ────────────────────────────────────────────────────────────────
  // PHOENIX_AUTH — set via: wrangler secret put PHOENIX_AUTH
  // Never put the token here — secrets only
}
