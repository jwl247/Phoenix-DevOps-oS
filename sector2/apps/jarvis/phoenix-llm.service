[Unit]
Description=Phoenix local LLM engine (llama.cpp llama-server) - localhost only, no network out, key required
# Replaces Ollama (Jerry, 2026-10-07: "no spies"). Ollama phoned ollama.com every ~4 h and had a cloud
# mode. This engine is built from pinned source with HTTPS compiled out (it cannot download anything),
# serves one model imported from the clone pool, and the kernel drops every non-loopback packet.
After=network.target

[Service]
User=llm
Group=llm
ExecStart=/opt/phoenix-llm/llama-server \
    --model /var/lib/llm/models/llama3.2-3b-q4km.gguf \
    --alias llama3.2:3b \
    --host 127.0.0.1 --port 8080 \
    --api-key-file /etc/phoenix-llm/engine.key \
    --no-webui --no-slots \
    --ctx-size 8192 --threads 4
Restart=always
RestartSec=5
# Rails: no network but loopback, no privilege gain, read-only everything except nothing.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
ReadOnlyPaths=/var/lib/llm/models
# JARVIS-S09 (2026-10-07): kernel/proc/syscall surface closed too
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
