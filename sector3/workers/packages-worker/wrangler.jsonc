// STALE COPY -- DO NOT DEPLOY. The canonical, live packages-worker source is
// sector2/package-handler/worker/ (merged there 2026-09-20). This copy predates
// the 2026-09-21 Gap 1 fix: /custody, /clonepool and /packages GETs here have NO
// auth, and "name" matches the live worker, so a `wrangler deploy` from this
// folder would silently overwrite production and re-open those routes.
// "main" points at a file that does not exist so any deploy fails loudly.
{
  "name": "packages-worker",
  "main": "STALE-COPY-DO-NOT-DEPLOY--use-sector2-package-handler-worker.js",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding":       "DEV_DB",
      "database_name": "phoenix_dev_db",
      "database_id":   "27958687-4349-47ed-8b6a-dbc4ab29730f"
    },
    {
      "binding":       "CATALOG_DB",
      "database_name": "phoenix-catalog",
      "database_id":   "0514d761-1db4-4e4f-8d1b-e5657909c0c0"
    }
  ],
  "r2_buckets": [
    {
      "binding":     "CLONEPOOL_BUCKET",
      "bucket_name": "phoenix-clonepool"
    }
  ]
}
