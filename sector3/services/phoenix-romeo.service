[Unit]
Description=Phoenix Romeo — sector 3 ingress router
Documentation=https://github.com/jwl247/Phoenix-DevOps-oS
After=network.target phoenix-sector2.target
Requires=network.target
PartOf=phoenix-sector3.target

[Service]
Type=simple
User=jwl247
Group=jwl247
WorkingDirectory=/home/jwl247/projects/phoenix
ExecStart=/usr/bin/env python3 /home/jwl247/projects/phoenix/sector3/romeo_juliet/romeo.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

Environment=PYTHONUNBUFFERED=1
Environment=PHOENIX_SECTOR=3
Environment=PHOENIX_ROMEO_PORT=5560
Environment=PHOENIX_ROMEO_BIND=tcp://0.0.0.0:5560
EnvironmentFile=-/home/jwl247/projects/phoenix/.env
EnvironmentFile=-/home/jwl247/.phoenix_env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/jwl247/projects/phoenix /home/jwl247/.unitedsys /tmp

StandardOutput=append:/var/log/phoenix/romeo.log
StandardError=append:/var/log/phoenix/romeo.error.log
SyslogIdentifier=phoenix-romeo

[Install]
WantedBy=phoenix-sector3.target
