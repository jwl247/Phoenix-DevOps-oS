# User-session target — wires Ollama + Phoenix desktop shell at graphical login.
# deploy-dashboard.sh enables this alongside individual units.

[Unit]
Description=Phoenix Desktop Session (Dashboard + Help Desk)
After=graphical-session.target network-online.target
Wants=phoenix-ollama.service phoenix-dashboard.service
Wants=network-online.target

[Install]
WantedBy=graphical-session.target