#!/usr/bin/env bash
# ============================================================
# Phoenix Global Command: clone
# Linux/macOS wrapper for Phoenix Clone (Sector 2 intake)
# ============================================================

set -euo pipefail

# Source Phoenix environment
[[ -f "$HOME/.phoenix_env.sh" ]] && source "$HOME/.phoenix_env.sh"

# Find Phoenix root
PHOENIX_ROOT="${PHOENIX_ROOT:-}"
if [[ -z "$PHOENIX_ROOT" ]]; then
    if [[ -f "$HOME/Phoenix/Phoenix-DevOps-oS/tools/clone.sh" ]]; then
        PHOENIX_ROOT="$HOME/Phoenix/Phoenix-DevOps-oS"
    elif [[ -f "$(dirname "$(dirname "${BASH_SOURCE[0]}")")/tools/clone.sh" ]]; then
        PHOENIX_ROOT="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
    fi
fi

if [[ -z "$PHOENIX_ROOT" ]]; then
    echo "[ERROR] PHOENIX_ROOT not set. Run install.sh first." >&2
    exit 1
fi

# Find clone.sh
CLONE_SH="$PHOENIX_ROOT/tools/clone.sh"
if [[ ! -f "$CLONE_SH" ]]; then
    echo "[ERROR] clone.sh not found at $CLONE_SH" >&2
    exit 1
fi

# Execute clone command
exec bash "$CLONE_SH" "$@"

