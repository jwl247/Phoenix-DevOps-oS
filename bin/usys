#!/usr/bin/env bash
# ============================================================
# Phoenix Global Command: usys
# Linux/macOS wrapper for USys (United Systems)
# ============================================================

set -euo pipefail

# Source Phoenix environment
[[ -f "$HOME/.phoenix_env.sh" ]] && source "$HOME/.phoenix_env.sh"

# Find Phoenix root
PHOENIX_ROOT="${PHOENIX_ROOT:-}"
if [[ -z "$PHOENIX_ROOT" ]]; then
    if [[ -f "$HOME/Phoenix/Phoenix-DevOps-oS/scripts/usys.ps1" ]]; then
        PHOENIX_ROOT="$HOME/Phoenix/Phoenix-DevOps-oS"
    elif [[ -f "$(dirname "$(dirname "${BASH_SOURCE[0]}")")/scripts/usys.ps1" ]]; then
        PHOENIX_ROOT="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"
    fi
fi

if [[ -z "$PHOENIX_ROOT" ]]; then
    echo "[ERROR] PHOENIX_ROOT not set. Run install.sh first." >&2
    exit 1
fi

# Find PowerShell (for cross-platform compatibility)
PWSH=""
if command -v pwsh &>/dev/null; then
    PWSH="pwsh"
elif command -v powershell &>/dev/null; then
    PWSH="powershell"
fi

if [[ -n "$PWSH" ]]; then
    # Use PowerShell if available
    exec "$PWSH" -NoProfile -ExecutionPolicy Bypass -Command \
        ". '$PHOENIX_ROOT/scripts/usys.ps1'; usys $*"
else
    # Fallback to bash usys if it exists
    BASH_USYS="$PHOENIX_ROOT/scripts/usys.sh"
    if [[ -f "$BASH_USYS" ]]; then
        exec bash "$BASH_USYS" "$@"
    else
        echo "[ERROR] Neither PowerShell nor bash usys found." >&2
        echo "Install PowerShell: https://aka.ms/install-powershell" >&2
        exit 1
    fi
fi

# Made with Bob
