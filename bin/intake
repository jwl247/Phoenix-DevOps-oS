#!/usr/bin/env bash
# ============================================================
# Phoenix Global Command: intake
# Linux/macOS wrapper for Phoenix Intake — IN to the Sector 2 clonepool
# (`bin/clone` is the OUT direction; Sector 4 vault intake is a separate
# command, `usys intake`, once sector4/intake.sh exists on the target machine)
# ============================================================

set -euo pipefail

# Source Phoenix environment
[[ -f "$HOME/.phoenix_env.sh" ]] && source "$HOME/.phoenix_env.sh"

# Find intake.sh
INTAKE_SH="${PHOENIX_INTAKE:-}"
# A stale PHOENIX_INTAKE (moved/deleted path) falls back to the repo copy
# instead of stopping with "not found" (2026-10-02: it pointed at a dead D: path).
[[ -n "$INTAKE_SH" && ! -f "$INTAKE_SH" ]] && INTAKE_SH=""

if [[ -z "$INTAKE_SH" ]]; then
    # Try common locations
    for candidate in \
        "$(dirname "$(dirname "${BASH_SOURCE[0]}")")/sector2/package-handler/intake.sh" \
        "$HOME/Phoenix/Phoenix-DevOps-oS/sector2/package-handler/intake.sh"
    do
        if [[ -f "$candidate" ]]; then
            INTAKE_SH="$candidate"
            break
        fi
    done
fi

if [[ -z "$INTAKE_SH" || ! -f "$INTAKE_SH" ]]; then
    echo "[ERROR] intake.sh not found." >&2
    echo "Set PHOENIX_INTAKE or run install.sh" >&2
    exit 1
fi

# Execute intake command
exec bash "$INTAKE_SH" "$@"
