#!/usr/bin/env bash
# ============================================================
# Phoenix Global Command: intake
# Linux/macOS wrapper for Phoenix Intake (Sector 2 clonepool — see `bin/clone`
# for the same pipeline; Sector 4 vault intake is a separate command, `usys
# intake`, once sector4/intake.sh exists on the target machine)
# ============================================================

set -euo pipefail

# Source Phoenix environment
[[ -f "$HOME/.phoenix_env.sh" ]] && source "$HOME/.phoenix_env.sh"

# Find intake.sh
INTAKE_SH="${PHOENIX_INTAKE:-}"

if [[ -z "$INTAKE_SH" ]]; then
    # Try common locations
    for candidate in \
        "$(dirname "$(dirname "${BASH_SOURCE[0]}")")/sector2/package-handler/intake.sh" \
        "$HOME/Phoenix/Phoenix-DevOps-oS/sector2/package-handler/intake.sh" \
        "$HOME/Phoenix/package-handler/intake.sh" \
        "$HOME/Phoenix/Phoenix-Package_handler/intake.sh"
    do
        if [[ -f "$candidate" ]]; then
            INTAKE_SH="$candidate"
            break
        fi
    done
fi

if [[ -z "$INTAKE_SH" || ! -f "$INTAKE_SH" ]]; then
    echo "[ERROR] intake.sh not found." >&2
    echo "Set PHOENIX_INTAKE or run install.sh" >&2
    exit 1
fi

# Execute intake command
exec bash "$INTAKE_SH" "$@"
