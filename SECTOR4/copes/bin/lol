#!/usr/bin/env python3
"""
Run this once on copes to install lol into ~/Phoenix/bin/
    python3 lol_install.py
"""
import os
import stat
from pathlib import Path

SCRIPT = r"""#!/usr/bin/env bash
# =============================================================================
# lol — Phoenix DevOps OS / COPES
# One command. File, package, or directory — lol handles it.
#
# Usage:
#   lol MYFILE.py.lol        # file    → pull from clone pool → $PWD
#   lol numpy.lol --pkg      # package → intake-package numpy
#   lol ~/src.lol            # dir     → intake-dir ~/src (auto-detected)
#
# Author:  jwl247 / Phoenix DevOps LLC
# License: GPL v3
# =============================================================================

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "  lol <file.lol>          pull from clone pool → here"
    echo "  lol <name.lol> --pkg    intake a package by name"
    echo "  lol <dir.lol>           intake a whole directory"
    exit 0
fi

INPUT="$1"
NAME="${INPUT%.lol}"

# ── Package ───────────────────────────────────────────────────────────────────
if [[ "${2:-}" == "--pkg" ]]; then
    echo "[lol] intake-package: $NAME"
    intake-package "$NAME" "${@:3}"
    exit 0
fi

# ── Directory (auto-detect) ───────────────────────────────────────────────────
RESOLVED=$(realpath "$NAME" 2>/dev/null || echo "$NAME")
if [[ -d "$RESOLVED" ]]; then
    echo "[lol] intake-dir: $RESOLVED"
    intake-dir "$RESOLVED" --summary "${@:2}"
    exit 0
fi

# ── File — pull from clone pool → $PWD ───────────────────────────────────────
echo "[lol] pulling: $NAME"
egress_helix egress "$NAME" --dest "$(pwd)"
[[ -f "$(pwd)/$NAME" ]] && echo "[lol] poof — $NAME is here." || echo "[lol] check egress above."
"""

dest = Path.home() / "Phoenix" / "bin" / "lol"
dest.parent.mkdir(parents=True, exist_ok=True)
dest.write_text(SCRIPT)
dest.chmod(dest.stat().st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
print(f"[lol] installed → {dest}")
print("[lol] ready.")
