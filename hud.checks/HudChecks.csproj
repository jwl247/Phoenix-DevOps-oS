<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for H.L.K-10's hands loop (hud/AiChatService.cs). A console
       program on purpose: it runs the real code against the real Console,
       hands and AI, not a mock. It is NOT a test project: `dotnet test` here
       discovers zero tests and exits 0, which means nothing (HUD-F12).
       Run the exe: `dotnet build` then bin/Debug/net9.0-windows/HudChecks.exe
       (offline part; exit code 0 = all passing). Add the live flag (dash dash live) for part 2 —
       that part restarts Ollama on pbm3, a real action, so don't run it blind. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HudChecks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\hud\Hud.csproj" />
  </ItemGroup>
</Project>
