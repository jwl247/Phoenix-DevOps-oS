# Line endings. Everything that runs on Linux (Phoenix's Debian boxes, the
# QEMU VM, pbm3, the Compaq) must stay LF even when checked out on Windows
# with core.autocrlf=true, or bash sees "bash\r" and units fail to parse.
* text=auto
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Makefile    text eol=lf
*.service   text eol=lf
*.target    text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
hands/** text eol=lf
# bin/ wrappers are extensionless bash scripts (S34OPS-F19) — LF, except the
# Windows .cmd twins, which cmd.exe wants CRLF.
bin/**      text eol=lf
bin/*.cmd   text eol=crlf
*.spec      text eol=lf
gradlew     text eol=lf
# Jarvis set is deployed straight to pbmIII (config.toml, identity .md) — LF
sector2/apps/jarvis/** text eol=lf
