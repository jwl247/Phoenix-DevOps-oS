# Line endings. Everything that runs on Linux (Phoenix's Debian boxes, the
# QEMU VM, pbm3, the Compaq) must stay LF even when checked out on Windows
# with core.autocrlf=true, or bash sees "bash\r" and units fail to parse.
* text=auto
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Makefile    text eol=lf
*.service   text eol=lf
*.target    text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
# Windows-side scripts keep CRLF
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
