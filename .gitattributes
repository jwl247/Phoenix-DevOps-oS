# Line endings. Everything that runs on Linux (Phoenix's Debian boxes, the
# QEMU VM, pbm3, the Compaq) must stay LF even when checked out on Windows
# with core.autocrlf=true, or bash sees "bash\r" and units fail to parse.
* text=auto
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.py        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Makefile    text eol=lf
*.service   text eol=lf
*.target    text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
hands/** text eol=lf
# the extensionless Linux wrappers in bin/ (usys, run, clone, intake, status, align_dirs,
# get_distros) are bash; their .cmd twins are Windows batch and stay CRLF (round-3 S34OPS-F19)
bin/*       text eol=lf
bin/*.cmd   text eol=crlf
bin/*.md    text
