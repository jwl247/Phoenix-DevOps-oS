<Window x:Class="Hud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hud"
        xmlns:controls="clr-namespace:Hud.Controls"
        mc:Ignorable="d"
        Title="Phoenix Console"
        WindowStyle="SingleBorderWindow"
        Background="#0A0D10"
        Topmost="False"
        ResizeMode="CanResize"
        FontFamily="Consolas">

    <Grid Margin="16">

        <!-- Top status strip — draggable, doubles as the window's title bar -->
        <Border Style="{StaticResource HudPanel}" Height="52" VerticalAlignment="Top"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <TextBlock Text="PHOENIX CONSOLE" Foreground="White" FontWeight="Bold"
                           FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <controls:KnightRiderBar x:Name="VoiceIndicator" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProviderLabel" Text="provider: —" Foreground="{StaticResource TextDim}"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,190,0"/>
                <Button x:Name="CliToggleButton" Content="CLI" Width="40" Height="28" HorizontalAlignment="Right"
                        Margin="0,0,36,0" Style="{StaticResource HudButton}" Click="ToggleCli_Click"
                        ToolTip="Show/hide the CLAUDE CODE pane"/>
                <Button x:Name="HudToggleButton" Content="HUD" Width="44" Height="28" HorizontalAlignment="Right"
                        Margin="0,0,82,0" Style="{StaticResource HudButton}" Click="ToggleHud_Click"
                        ToolTip="Launch / hide the HUD: see-through, chat with Claude, drop files on the left edge (Ctrl+Alt+Space)"/>
                <Button x:Name="SuitsButton" Content="SUITS" Width="54" Height="28" HorizontalAlignment="Right"
                        Margin="0,0,130,0" Style="{StaticResource HudButton}" Click="Suits_Click"
                        ToolTip="Suit look-up: find a suit in the pool by name or what it does, read it, import (run) it"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource HudButton}" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- CLAUDE CODE — full Claude Code (every tool, in the repo), built the
             same way as H.L.K-10's pane: part of the HUD, see-through, driven
             by background `claude -p` runs (ClaudeCodeSession). Replaced the
             old ConPTY terminal, which had to live in a separate opaque window
             (WPF can't draw native controls in a transparent window) and died
             to "Session Terminated". Jerry, 2026-09-27: "make claude cli like
             the hlk10's, it'd work, being clear".
             Right column, filling the gap between LIVE MONITOR (64..264) and
             H.L.K-10 (bottom, 293 tall) with 12px spacing (Jerry, 2026-09-29). -->
        <Border x:Name="ClaudeCodePane" Style="{StaticResource HudPanel}" Width="340" HorizontalAlignment="Right"
                VerticalAlignment="Stretch" Margin="0,276,0,305">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="CLAUDE CODE" Foreground="{StaticResource HoloCyan}" FontSize="13"
                               FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ClaudeCodeStatus" Text="ready" Foreground="{StaticResource PhoenixGold}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="110,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ClaudeCodeStopButton" Content="STOP" Style="{StaticResource HudButton}"
                                Padding="8,2" Margin="0,0,6,0" IsEnabled="False" Click="ClaudeCodeStop_Click"
                                ToolTip="Stop what it's doing right now"/>
                        <Button Content="NEW" Style="{StaticResource HudButton}" Padding="8,2"
                                Click="ClaudeCodeNew_Click" ToolTip="Start a fresh conversation"/>
                    </StackPanel>
                </Grid>

                <!-- Same readable backing + bright-yellow text as H.L.K-10's log,
                     and a read-only TextBox so it can be selected and copied. -->
                <Border Grid.Row="1" Background="#0C0E12" Opacity="0.9" CornerRadius="4" Padding="6">
                    <TextBox x:Name="ClaudeCodeLog" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#FFFF00" BorderThickness="0"
                             FontSize="13" Cursor="IBeam"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ClaudeCodeInput" Grid.Column="0" Background="#0A0D10" Foreground="White"
                             BorderBrush="{StaticResource HoloCyan}" BorderThickness="1" Padding="6"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="ClaudeCodeInput_PreviewKeyDown"
                             ToolTip="Enter sends · Shift+Enter for a new line"/>
                    <Button Grid.Column="1" Content="SEND" Style="{StaticResource HudButton}"
                            Margin="6,0,0,0" Click="ClaudeCodeSend_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Live Monitor — continuous desktop capture, top-right corner, edge-anchored -->
        <Border Style="{StaticResource HudPanel}" Width="340" Height="200"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,0,0">
            <Grid>
                <TextBlock Text="LIVE MONITOR" Foreground="{StaticResource HoloCyan}" FontSize="11"
                           FontWeight="Bold" Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Image x:Name="LiveMonitorImage" Margin="8,28,8,8" Stretch="Uniform"/>
            </Grid>
        </Border>

        <!-- AI Chat — H.L.K-10's comms panel, bottom-right, edge-anchored -->
        <Border Style="{StaticResource HudPanel}" Width="340" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,0,0" Height="293">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="H.L.K-10" Foreground="{StaticResource HoloCyan}"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                <!-- The rest of the HUD is deliberately near-transparent (HudPanel
                     style, 28% opacity) so the desktop shows through — but that
                     means text contrast depends on whatever's behind the HUD at
                     the moment (white Explorer window, tan wallpaper, etc.), so
                     no single text color reads reliably. Chat readability is the
                     one place that tradeoff isn't worth it (Jerry, 2026-09-22:
                     "the text needs to be bright yellow... i cant read it very
                     well") — give just this panel a solid-enough backing instead. -->
                <!-- A TextBlock/ItemsControl (the original approach) can't be
                     selected or copied at all — a real WPF limitation, not a
                     bug (Jerry, 2026-09-22: "i cant copy and paste from that
                     box"). A read-only TextBox gives real click-drag-select +
                     Ctrl+C, same as any normal text log. -->
                <Border Grid.Row="1" Background="#0C0E12" Opacity="0.9" CornerRadius="4" Padding="6">
                    <TextBox x:Name="ChatLog" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#FFFF00" BorderThickness="0"
                             FontSize="12" Cursor="IBeam"/>
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Grid.Column="0" Background="#0A0D10" Foreground="White"
                             BorderBrush="{StaticResource HoloCyan}" BorderThickness="1" Padding="6"
                             KeyDown="ChatInput_KeyDown"/>
                    <Button Grid.Column="1" Content="SEND" Style="{StaticResource HudButton}"
                            Margin="6,0,0,0" Click="Send_Click"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
