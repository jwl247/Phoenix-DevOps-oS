<Window x:Class="Hud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hud"
        xmlns:controls="clr-namespace:Hud.Controls"
        mc:Ignorable="d"
        Title="Phoenix Console"
        WindowStyle="SingleBorderWindow"
        Background="#0A0D10"
        Topmost="False"
        ResizeMode="CanMinimize"
        SizeToContent="Height"
        Width="604"
        FontFamily="Consolas">

    <!-- The Console (Jerry 10/8): "it only needs to be as wide as the button field, add Jarvis under
         that and that's it". The buttons, Jarvis, nothing else. The earlier panes (Live Monitor,
         H.L.K-10 chat, CLAUDE CODE) are kept below, hidden, with their code intact. -->
    <StackPanel Margin="12">

        <!-- Title strip — draggable -->
        <Border Style="{StaticResource HudPanel}" Height="44" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0">
                <TextBlock Text="PHOENIX CONSOLE" Foreground="White" FontWeight="Bold"
                           FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <controls:KnightRiderBar x:Name="VoiceIndicator" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"/>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        Style="{StaticResource HudButton}" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- EASY BUTTONS: one per usys command; each runs in its own PS7 window that stays open.
             The word on a button is the word you'd type after usys. -->
        <Border Style="{StaticResource HudPanel}" Margin="0,10,0,0">
            <StackPanel Margin="12">
                <TextBlock Text="USYS — ONE WORD" Foreground="{StaticResource HoloCyan}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                <WrapPanel x:Name="EasyButtons">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                            <Setter Property="Width" Value="126"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="IMPORT" Tag="import" Click="Easy_Click" ToolTip="usys import: the import method - pick a suit file or type a suit name; R2 -> memory -> run, never on disk"/>
                    <Button Content="INTAKE S" Tag="intakes" Click="Easy_Click" ToolTip="usys intakeS: put a SUIT (.py .sh .ps1 .js) into Phoenix"/>
                    <Button Content="INTAKE C" Tag="intakec" Click="Easy_Click" ToolTip="usys intakeC: put any FILE into the clone pool"/>
                    <Button Content="INTAKE C ▸ FOLDER" Tag="intakec-folder" Click="Easy_Click" FontSize="11" ToolTip="usys intakeC: put a FOLDER (or a game/program folder) into the clone pool"/>
                    <Button Content="GET" Tag="get" Click="Easy_Click" ToolTip="usys get: a copy OUT of Phoenix into a folder you pick, hash-checked"/>
                    <Button Content="RUN" Tag="run" Click="Easy_Click" ToolTip="usys run: run an app, a game or a VM (e.g. coldwaters, debian)"/>
                    <Button Content="OPEN" Tag="open" Click="Easy_Click" ToolTip="usys open: open a file with its app"/>
                    <Button Content="CLOSET" Tag="closet" Click="Easy_Click" ToolTip="usys closet: the suits in the closet"/>
                    <Button Content="STATUS" Tag="status" Click="Easy_Click" ToolTip="usys status: is Phoenix healthy (kernel included)"/>
                    <Button Content="START" Tag="start" Click="Easy_Click" ToolTip="usys start: the kernel on"/>
                    <Button Content="STOP" Tag="stop" Click="Easy_Click" ToolTip="usys stop: the kernel off"/>
                    <Button Content="LOG" Tag="log" Click="Easy_Click" ToolTip="usys log: the kernel's log"/>
                    <Button Content="DOCKS" Tag="docks" Click="Easy_Click" ToolTip="Open / close the HUD's docks by hand"/>
                    <Button Content="SUITS" Click="Suits_Click" ToolTip="Suit look-up: find a suit by name or what it does, read it, import (run) it"/>
                    <Button Content="GLOSSARY" Click="Glossary_Click" ToolTip="Find any file in Phoenix by name or what it does and read its code (custody-checked)"/>
                    <Button Content="EXPLORER" Click="Files_Click" ToolTip="File Explorer in F:\Phoenix"/>
                    <Button Content="TERMINAL" Click="Terminal_Click" ToolTip="A PS7 terminal in the Phoenix repo"/>
                    <Button Content="HELP" Tag="help" Click="Easy_Click" ToolTip="usys help: the commands cheat sheet"/>
                    <Button Content="ROTATE" Tag="rotate" Click="Easy_Click" Foreground="#FF6B6B"
                            ToolTip="rotate-key: new PHOENIX_AUTH + Cloudflare Access secret on every worker, this PC and the vault. Opens a PS7 window; you type ROTATE there. Jerry's account only."/>
                </WrapPanel>
                <TextBlock x:Name="EasyStatus" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Each button opens a PS7 window with the answer. The word on the button is what you'd type after usys."/>
            </StackPanel>
        </Border>

        <!-- JARVIS, under the buttons (Jerry 10/8). Through his gate on pbmIII (bin/jarvis). -->
        <Border Style="{StaticResource HudPanel}" Margin="0,10,0,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="JARVIS" Foreground="{StaticResource HoloCyan}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="#0C0E12" Opacity="0.9" CornerRadius="4" Padding="6">
                    <TextBox x:Name="JarvisLog" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#FFFF00" BorderThickness="0"
                             FontSize="12" Cursor="IBeam"/>
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JarvisInput" Grid.Column="0" Background="#0A0D10" Foreground="White"
                             BorderBrush="{StaticResource HoloCyan}" BorderThickness="1" Padding="6"
                             KeyDown="JarvisInput_KeyDown" ToolTip="Ask Jarvis - Enter sends"/>
                    <Button x:Name="JarvisAskButton" Grid.Column="1" Content="ASK" Style="{StaticResource HudButton}"
                            Margin="6,0,0,0" Click="JarvisAsk_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden, kept: the earlier Console panes. Their code-behind still runs (the Live Monitor
             frame + transcripts on E:\Phoenix\hud-live-monitor\ that other sessions read). -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="ProviderLabel"/>
            <Border x:Name="ClaudeCodePane">
                <StackPanel>
                    <TextBlock x:Name="ClaudeCodeStatus"/>
                    <Button x:Name="ClaudeCodeStopButton" Click="ClaudeCodeStop_Click"/>
                    <Button Click="ClaudeCodeNew_Click"/>
                    <TextBox x:Name="ClaudeCodeLog" IsReadOnly="True"/>
                    <TextBox x:Name="ClaudeCodeInput" PreviewKeyDown="ClaudeCodeInput_PreviewKeyDown"/>
                    <Button Click="ClaudeCodeSend_Click"/>
                </StackPanel>
            </Border>
            <Image x:Name="LiveMonitorImage"/>
            <TextBox x:Name="ChatLog" IsReadOnly="True"/>
            <TextBox x:Name="ChatInput" KeyDown="ChatInput_KeyDown"/>
            <Button Click="Send_Click"/>
            <Button x:Name="CliToggleButton" Click="ToggleCli_Click"/>
            <Button x:Name="HudToggleButton" Click="ToggleHud_Click"/>
            <Button x:Name="SuitsButton" Click="Suits_Click"/>
        </Grid>
    </StackPanel>
</Window>
