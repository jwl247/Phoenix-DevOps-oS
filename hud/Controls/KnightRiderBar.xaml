<UserControl x:Class="Hud.Controls.KnightRiderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="12" Width="240">
    <!--
        KITT scanner / Cylon eye — the visible sign of the voice pipeline's
        state (idle/listening/thinking/speaking), not just a text label. Pure
        vector + brush animation, so it lives directly in the transparent
        MainWindow overlay with no airspace workaround needed (that limit
        only applies to native HwndHost controls like the ConPTY terminal).
    -->
    <Grid>
        <Border CornerRadius="6" Background="#1A0000" BorderBrush="#402020" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="ScanCanvas" ClipToBounds="True">
                <Ellipse x:Name="Eye" Width="50" Height="12" Canvas.Left="0" Canvas.Top="0" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="EyeCoreStop" Color="#FFFF3300" Offset="0"/>
                            <GradientStop Color="#00FF3300" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="8"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
