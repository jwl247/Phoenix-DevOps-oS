<Window x:Class="Hud.HudOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hud.Controls"
        Title="Phoenix HUD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Consolas">
    <!-- See-through and click-through: only the chat column and the drop shelf have
         pixels; everywhere else is fully transparent, and a layered window passes
         clicks on fully transparent pixels straight to whatever is underneath. -->
    <Grid>
        <!-- Drop shelf: a 6 px strip on the left edge (#01 alpha = invisible but still
             catches a drag). Drag anything toward it and it opens; drop for the menu. -->
        <Border x:Name="Shelf" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6"
                Background="#01000000" AllowDrop="True"
                DragEnter="Shelf_DragEnter" DragOver="Any_DragOver" DragLeave="Shelf_DragLeave" Drop="Any_Drop">
            <TextBlock x:Name="ShelfText" Text="DROP&#x0a;HERE" Visibility="Collapsed" Foreground="#7FFFD4"
                       FontSize="22" FontWeight="Bold" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Chat only. Claude. -->
        <Border Style="{StaticResource HudPanel}" Background="#F00A0D10" Width="420" HorizontalAlignment="Right" Margin="0,16,16,16"
                AllowDrop="True" DragOver="Any_DragOver" Drop="Any_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <controls:KnightRiderBar x:Name="Bar" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Header" Text="CLAUDE" Foreground="#7FFFD4" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="—" Width="28" Height="24" HorizontalAlignment="Right" ToolTip="Hide (Ctrl+Alt+Space)"
                            Style="{StaticResource HudButton}" Click="Hide_Click"/>
                </Grid>
                <TextBox x:Name="ChatLog" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#CFE8E0"
                         BorderThickness="0" FontSize="13"/>
                <TextBlock x:Name="Attached" Grid.Row="2" Foreground="#5A7A70" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="Collapsed"/>
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Grid.Column="0" Background="#0A0D10" Foreground="White" CaretBrush="#7FFFD4"
                             BorderBrush="#2A4A40" Padding="4" AcceptsReturn="False" KeyDown="ChatInput_KeyDown"/>
                    <Button Grid.Column="1" Content="SEND" Style="{StaticResource HudButton}" Margin="6,0,0,0" Click="Send_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
