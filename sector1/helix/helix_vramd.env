# /etc/default/helix-vram — settings for helix-vram.service (helix_vramd.py).
# Installed once by tools/helix-team/install-team.sh; never overwritten.
# Sizes in MiB. Her real config (CLAUDE.md "4GB of 8GB RAM") is the default:
HELIX_VRAM_HOT_MB=256
HELIX_VRAM_WARM_MB=1024
HELIX_VRAM_COLD_MB=3072
HELIX_VRAM_STRAND_B_MB=8192
HELIX_VRAM_STRAND_B=/var/lib/helix/vram
HELIX_VRAM_SOCK=/run/phoenix/helix-vram.sock
# HELIX_VRAM_NO_KERNEL=1   # only on a box without helix.ko (she then runs standalone)
