# Phoenix DevOps OS — environment template
# Generated by bootstrap.sh — do not commit the real version of this file.
# Copy: cp .env.example ~/.phoenix_env  then fill in your values.
# Source every session: source ~/.phoenix_env

# ── Core paths ───────────────────────────────────────────────────────────────
export PHOENIX_HOME="$HOME/Phoenix"
export PHOENIX_INSTALL_DIR="$HOME/phoenix-devops"
export PHOENIX_CLONEPOOL="$HOME/Phoenix/clonepool"
export PHOENIX_BIN="$HOME/Phoenix/bin"
export PHOENIX_CARDS="$HOME/Phoenix/cards"
export PHOENIX_LOG="$HOME/Phoenix/logs/phoenix.log"

# ── Sector paths (set to your install directory) ─────────────────────────────
export PHOENIX_SECTOR1="$HOME/phoenix-devops/sector1"
export PHOENIX_SECTOR2="$HOME/phoenix-devops/sector2"
export PHOENIX_SECTOR3="$HOME/phoenix-devops/sector3"
export PHOENIX_SECTOR4="$HOME/phoenix-devops/sector4"

# ── Auth token — generated by bootstrap.sh (openssl rand -hex 32) ────────────
# NEVER share this. NEVER commit this file once filled in.
export PHOENIX_AUTH="<generated-by-bootstrap>"

# ── Cloudflare worker — D1 sync (optional — system works offline without it) ──
export PHOENIX_WORKER_URL="https://packages-worker.phoenix-jwl.workers.dev"

# ── Platform ──────────────────────────────────────────────────────────────────
export PHOENIX_PLATFORM="linux"

# ── Python path — makes unitedsys importable ──────────────────────────────────
export PYTHONPATH="$HOME/phoenix-devops:${PYTHONPATH:-}"

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH="$HOME/Phoenix/bin:${PATH}"

# ── Aliases ───────────────────────────────────────────────────────────────────
alias intake="python3 $HOME/phoenix-devops/unitedsys/core/intake.py"
