#cloud-config
hostname: phoenix-debian
ssh_pwauth: true
users:
  - name: phoenix
    plain_text_passwd: phoenix
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
chpasswd:
  expire: false

packages:
  - cifs-utils

write_files:
  # NOTE: this cloud-init seed can no longer bake in the real SMB password —
  # a real Windows account password was hardcoded here in plaintext, pushed
  # to the public GitHub repo from 2026-08-23 to 2026-09-25 (see CLAUDE.md
  # session log), and must now be treated as permanently compromised. Set
  # /etc/phoenix-cifs.creds via persist-smb-mount.sh instead (now requires
  # SMB_PASS as a required env var, never hardcoded) after boot, or inject a
  # real secret through cloud-init's own vendor-data/instance-data mechanism
  # rather than committing it to this file.

  - path: /etc/systemd/system/phoenix-helix-kernel.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Phoenix Helix Lightning Kernel (paging brain — Debian side)
      After=network-online.target
      Wants=network-online.target
      StartLimitBurst=5
      StartLimitIntervalSec=120

      [Service]
      Type=simple
      User=root
      Environment=PHOENIX_HELIX_PAGE_DIR=/phoenix/helix-pages
      Environment=PHOENIX_PAGING_SNAPSHOT_PATH=/phoenix/helix-pages/windows_snapshot.json
      Environment=PHOENIX_PAGING_NVME_MOUNT=/phoenix/swap
      Environment=PHOENIX_PAGING_SWAPFILE_PATH=/var/swap/swapfile
      Environment=PHOENIX_PAGING_INITIAL_SWAP_GB=1.0
      Environment=PHOENIX_PAGING_MIN_SWAP_GB=0.5
      Environment=PHOENIX_PAGING_MAX_SWAP_GB=8.0
      ExecStartPre=/bin/bash -c 'test -d /phoenix/helix-pages || (echo "[HELIX] /phoenix not mounted" && exit 1)'
      ExecStart=/usr/bin/python3 /phoenix/helix-pages/paging.py start
      Restart=on-failure
      RestartSec=10
      StandardOutput=journal
      StandardError=journal
      SyslogIdentifier=phoenix-helix-kernel

      [Install]
      WantedBy=multi-user.target

runcmd:
  - mkdir -p /phoenix /var/swap
  - sed -i '/10.0.2.2\/Phoenix/d' /etc/fstab
  - echo '//10.0.2.2/Phoenix  /phoenix  cifs  credentials=/etc/phoenix-cifs.creds,uid=1000,gid=1000,iocharset=utf8,vers=3.0,nofail,_netdev  0  0' >> /etc/fstab
  - systemctl daemon-reload
  - mount /phoenix || true
  - dd if=/dev/zero of=/var/swap/swapfile bs=1M count=200 status=none
  - chmod 600 /var/swap/swapfile
  - mkswap /var/swap/swapfile
  - swapon /var/swap/swapfile
  - systemctl daemon-reload
  - systemctl enable phoenix-helix-kernel.service
  - systemctl start phoenix-helix-kernel.service || true
